# ADS Query Engine host (Overview → Connection Details)
ADS_QUERY_HOST=ads-cloudflare-poc-k9pb59-tor1.aidp-preview.ondigitalocean.com

# DuckDB / ADBC Quack — Overview snippet uses TOKEN 'reader:<password>'
# Example: ADS_QUACK_TOKEN=reader:XG2...
ADS_QUACK_TOKEN=reader:replace_me

# Fully qualified Iceberg table
ADS_TABLE=tabular.ads_cloudflare_poc.cf_request_log

# Cache TTL for aggregate endpoints (seconds). Aggregates are expensive — keep high.
CACHE_TTL_SECONDS=1800

# Query timeout sent to Quack (seconds)
ADS_TIMEOUT_SECONDS=180

# Max concurrent Quack queries from this app
ADS_QUERY_CONCURRENCY=4
