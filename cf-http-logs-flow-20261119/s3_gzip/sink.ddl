CREATE TABLE IF NOT EXISTS cf_request_log_20261119 (
    ray_id VARCHAR,
    edge_start_timestamp TIMESTAMPTZ,
    edge_end_timestamp TIMESTAMPTZ,
    zone_name VARCHAR,
    client_request_host VARCHAR,
    client_request_method VARCHAR,
    client_request_path VARCHAR,
    client_request_uri VARCHAR,
    client_request_protocol VARCHAR,
    client_request_referer VARCHAR,
    client_request_user_agent VARCHAR,
    client_request_bytes BIGINT,
    edge_response_status BIGINT,
    edge_response_bytes BIGINT,
    edge_response_body_bytes BIGINT,
    edge_response_content_type VARCHAR,
    origin_response_status BIGINT,
    security_action VARCHAR,
    edge_time_to_first_byte_ms BIGINT,
    origin_response_duration_ms BIGINT,
    client_tcp_rtt_ms BIGINT,
    cache_cache_status VARCHAR,
    cache_response_status BIGINT,
    client_asn BIGINT,
    client_country VARCHAR,
    client_region_code VARCHAR,
    client_device_type VARCHAR,
    client_ip VARCHAR,
    client_ssl_protocol VARCHAR,
    ja3_hash VARCHAR,
    edge_colo_id BIGINT,
    edge_colo_code VARCHAR,
    origin_ip VARCHAR,
    object_key VARCHAR,
    line_no BIGINT,
    ingested_at TIMESTAMPTZ
) PARTITIONED BY (day(edge_start_timestamp));
